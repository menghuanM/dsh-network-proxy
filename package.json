{
  "name": "@menghuanm/dsh-network-proxy",
  "version": "2.2.1",
  "type": "module",
  "description": "DeepSeek Harness 网络代理插件：跟随系统 / 手动代理 / 直连，修改后立即生效。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "PATCHES.md",
    "CHANGELOG.md",
    "smoke-test.mjs"
  ],
  "scripts": {
    "test": "node smoke-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "dependencies": {
    "undici": "^7.18.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "proxy",
    "network"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "license": "MIT"
}
